generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
}
enum OrgType {
  LARGE
  MIDSIZE
  SMALL
  OTHER
}

model Organization {
  org_id   Int     @id @default(autoincrement())
  org_did  String  @unique @db.VarChar(255)
  org_name String  @db.VarChar(255)
  org_type OrgType @default(OTHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

