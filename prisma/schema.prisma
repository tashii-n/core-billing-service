generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * ---------- Enums ----------
 */

enum OrgType {
  SMALL
  MEDIUM
  LARGE
  OTHER
}

enum BillingModel {
  SUBSCRIPTION
  PAY_PER_USE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  CANCELED
  EXPIRED
}

enum UsageResult {
  SUCCESS
  FAILED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  OVERDUE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

/**
 * ---------- Core Tables ----------
 */

model Organization {
  org_id     BigInt   @id @default(autoincrement())
  org_did    String   @unique
  org_name   String
  org_type   OrgType
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]
  usage_events  UsageEvent[]
  transactions  Transaction[]

  @@map("organizations")
}

model Service {
  service_id               BigInt  @id @default(autoincrement())
  service_name             String
  org_type_eligible Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  plans         Plan[]
  subscriptions Subscription[]
  usage_events  UsageEvent[]

  @@map("services")
}

model Plan {
  plan_id        BigInt       @id @default(autoincrement())
  service_id     BigInt
  plan_code      String // BASIC/PLUS/PREMIUM/PAYG
  billing_period String // MONTHLY/YEARLY (or make enum later)
  billing_model  BillingModel
  is_active      Boolean      @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  service Service @relation(fields: [service_id], references: [service_id])

  prices        PlanPrice[]
  entitlements  PlanEntitlement[]
  usage_rates   PlanUsageRate[]
  subscriptions Subscription[]
  usage_events  UsageEvent[]

  @@unique([service_id, plan_code])
  @@index([service_id])
  @@map("plans")
}

/**
 * ---------- Pricing Tables ----------
 */

model PlanPrice {
  plan_price_id BigInt   @id @default(autoincrement())
  plan_id       BigInt
  org_type      OrgType? // NULL = default rate
  currency      String   @default("BTN")
  fixed_fee     Decimal  @db.Decimal(12, 2)

  effective_from DateTime
  effective_to   DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  plan Plan @relation(fields: [plan_id], references: [plan_id])

  @@index([plan_id])
  @@index([plan_id, org_type])
  @@map("plan_prices")
}

model PlanEntitlement {
  entitlement_id BigInt   @id @default(autoincrement())
  plan_id        BigInt
  org_type       OrgType? // NULL = default
  metric         String? // sessions, otp_sent, etc.

  included_quantity  BigInt
  overage_unit_price Decimal? @db.Decimal(12, 4)
  hard_limit         Boolean  @default(false)
  period             String // PER_BILLING_CYCLE (or similar)

  effective_from DateTime
  effective_to   DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  plan Plan @relation(fields: [plan_id], references: [plan_id])

  @@index([plan_id, metric])
  @@index([plan_id, metric, org_type])
  @@map("plan_entitlements")
}

model PlanUsageRate {
  rate_id    BigInt   @id @default(autoincrement())
  plan_id    BigInt
  org_type   OrgType? // NULL = default
  metric     String?
  unit_price Decimal  @db.Decimal(12, 4)

  effective_from DateTime
  effective_to   DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  plan Plan @relation(fields: [plan_id], references: [plan_id])

  @@index([plan_id, metric])
  @@index([plan_id, metric, org_type])
  @@map("plan_usage_rates")
}

/**
 * ---------- Subscription + Usage ----------
 */

model Subscription {
  subscription_id BigInt @id @default(autoincrement())

  org_id     BigInt
  service_id BigInt
  plan_id    BigInt

  status SubscriptionStatus

  start_date DateTime  @default(now())
  end_date   DateTime?

  current_period_start DateTime?
  current_period_end   DateTime?

  cancel_at_period_end Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization Organization @relation(fields: [org_id], references: [org_id])
  service      Service      @relation(fields: [service_id], references: [service_id])
  plan         Plan         @relation(fields: [plan_id], references: [plan_id])

  usage_events UsageEvent[]

  @@index([org_id, service_id, status])
  @@index([plan_id])
  @@map("subscriptions")
}

model UsageEvent {
  usage_id    BigInt   @id @default(autoincrement())
  occurred_at DateTime @default(now())

  org_id          BigInt
  service_id      BigInt
  subscription_id BigInt
  plan_id         BigInt

  metric String?
  result UsageResult

  external_ref String @unique // idempotency
  metadata     Json?

  created_at DateTime @default(now())

  organization Organization @relation(fields: [org_id], references: [org_id])
  service      Service      @relation(fields: [service_id], references: [service_id])
  subscription Subscription @relation(fields: [subscription_id], references: [subscription_id])
  plan         Plan         @relation(fields: [plan_id], references: [plan_id])

  @@index([subscription_id, metric, occurred_at])
  @@index([org_id, service_id, occurred_at])
  @@map("usage_events")
}

/**
 * ---------- Invoicing ----------
 */

model Invoice {
  invoice_id BigInt @id @default(autoincrement())

  org_id       BigInt
  period_start DateTime
  period_end   DateTime

  status   InvoiceStatus @default(DRAFT)
  currency String        @default("BTN")

  subtotal     Decimal @default(0) @db.Decimal(12, 2)
  tax_total    Decimal @default(0) @db.Decimal(12, 2)
  total_amount Decimal @default(0) @db.Decimal(12, 2)

  issued_at DateTime?
  due_at    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization Organization  @relation(fields: [org_id], references: [org_id])
  lines        InvoiceLine[]
  transactions Transaction[]

  @@unique([org_id, period_start, period_end])
  @@index([org_id, status])
  @@map("invoices")
}

model InvoiceLine {
  line_id    BigInt @id @default(autoincrement())
  invoice_id BigInt

  description String
  metric      String?
  quantity    Decimal? @db.Decimal(18, 4)
  unit_price  Decimal? @db.Decimal(12, 4)
  amount      Decimal  @db.Decimal(12, 2)

  created_at DateTime @default(now())

  invoice Invoice @relation(fields: [invoice_id], references: [invoice_id])

  @@index([invoice_id])
  @@map("invoice_lines")
}

model Transaction {
  transaction_id BigInt @id @default(autoincrement())

  invoice_id BigInt?
  org_id     BigInt

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("BTN")

  payment_status   PaymentStatus
  transaction_date DateTime      @default(now())
  reference        String?

  created_at DateTime @default(now())

  invoice      Invoice?     @relation(fields: [invoice_id], references: [invoice_id])
  organization Organization @relation(fields: [org_id], references: [org_id])

  @@index([org_id, transaction_date])
  @@index([invoice_id])
  @@map("transactions")
}
